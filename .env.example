# =============================================================================
# DocuChat Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- LLM API Keys ---
# OpenAI API key (required if using OpenAI as LLM/embedding provider)
OPENAI_API_KEY=your_openai_api_key_here


# Anthropic API key (required if using Anthropic as LLM provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Provider Configuration ---
# LLM provider: "openai" or "anthropic"
LLM_PROVIDER=openai

# Embedding provider: "openai" or "voyage"
EMBEDDING_PROVIDER=openai

# --- Database ---
# Local dev default (SQLite). For prod, use a Neon Postgres URL — note the
# +asyncpg driver suffix and `?ssl=require` (asyncpg uses `ssl=`, not Neon's
# default `sslmode=`).
#   postgresql+asyncpg://USER:PASS@ep-xxx.us-east-1.aws.neon.tech/neondb?ssl=require
#
# Vectors are stored in Postgres via pgvector — the `vector` extension is
# created automatically on startup. No separate vector DB to configure.
DATABASE_URL=sqlite+aiosqlite:///./docuchat.db

# --- Storage Backend ---
# "local" for development, "s3" for production (works with AWS S3 or Cloudflare R2).
STORAGE_BACKEND=local

# For Cloudflare R2 (free 10GB):
#   1. Create a bucket in the Cloudflare R2 dashboard.
#   2. Generate an API token (R2 → Manage API Tokens → Object Read & Write).
#   3. Fill in below and set STORAGE_BACKEND=s3.
S3_BUCKET=
S3_ENDPOINT_URL=         # R2: https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto           # R2 expects "auto"; for AWS S3 set to e.g. "us-east-1"

# --- Application ---
# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Additional comma-separated CORS origins (prod: your Vercel URL)
# e.g. EXTRA_CORS_ORIGINS=https://docuchat.vercel.app,https://docuchat-pr-7.vercel.app
EXTRA_CORS_ORIGINS=

# Cookies — for cross-origin prod (Vercel frontend ↔ Render backend) set BOTH:
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=none
# Leave defaults for local dev over HTTP.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Backend port
BACKEND_PORT=8000
