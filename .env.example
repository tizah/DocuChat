# =============================================================================
# DocuChat Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- LLM API Keys ---
# OpenAI API key (required if using OpenAI as LLM/embedding provider)
OPENAI_API_KEY=your_openai_api_key_here


# Anthropic API key (required if using Anthropic as LLM provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Provider Configuration ---
# LLM provider: "openai" or "anthropic"
LLM_PROVIDER=openai

# Embedding provider: "openai" or "voyage"
EMBEDDING_PROVIDER=openai

# --- Vector Store ---
# ChromaDB host for production (leave empty for local dev)
CHROMA_HOST=

# --- AWS (for production deployment) ---
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name_here

# --- Storage Backend ---
# "local" for development, "s3" for production
STORAGE_BACKEND=local

# --- Application ---
# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Backend port
BACKEND_PORT=8000
